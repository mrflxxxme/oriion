{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oriion.dev/schemas/handoff-event.v1.json",
  "title": "Oriion Pipeline Handoff Event",
  "description": "CloudEvents 1.0 compliant handoff between AI-team roles. Used for inter-role messaging within Oriion pipelines (backend-feature, frontend-feature, full-stack-feature). Extension attributes are prefixed with 'oriion_' per CloudEvents naming convention.",
  "type": "object",
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "datacontenttype",
    "time",
    "data"
  ],
  "properties": {
    "specversion": {
      "const": "1.0",
      "description": "CloudEvents spec version. Pinned to 1.0."
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique event identifier (UUID v4 recommended)."
    },
    "source": {
      "type": "string",
      "pattern": "^oriion://agents/[a-z-]+$",
      "description": "URI identifying the emitting role, e.g. oriion://agents/planner"
    },
    "type": {
      "type": "string",
      "pattern": "^tech\\.oriion\\.[a-z]+\\.[a-z_]+\\.v[0-9]+$",
      "description": "Reverse-DNS event type with explicit version suffix."
    },
    "subject": {
      "type": "string",
      "description": "Phase-id or task-id this event pertains to."
    },
    "datacontenttype": {
      "const": "application/json"
    },
    "time": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 timestamp of event emission."
    },
    "data": {
      "type": "object",
      "description": "Event-type-specific payload. See $defs for per-type schemas."
    },
    "oriion_pipeline_id": {
      "type": "string",
      "description": "Identifier of the pipeline instance executing this handoff."
    },
    "oriion_role_from": {
      "type": "string",
      "enum": [
        "architect",
        "planner",
        "memory-curator",
        "designer",
        "frontend-implementer",
        "backend-implementer",
        "reviewer-frontend",
        "reviewer-backend",
        "reviewer-security",
        "verifier",
        "evaluator"
      ]
    },
    "oriion_role_to": {
      "type": ["string", "array"],
      "description": "Target role(s). Array form supports fan-out (e.g. parallel reviewers)."
    },
    "oriion_revision_cycle": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "description": "Current revision cycle (0 = first attempt). Hard cap per ADR-027."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "tech.oriion.plan.task.v1": {
      "type": "object",
      "required": ["phase_id", "task_id", "role", "deliverables"],
      "properties": {
        "phase_id": {"type": "string"},
        "task_id": {"type": "string"},
        "role": {"type": "string"},
        "depends_on": {
          "type": "array",
          "items": {"type": "string"}
        },
        "deliverables": {
          "type": "array",
          "items": {"type": "string"},
          "description": "Expected artifacts (file paths or artifact-ids)."
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.code.commit.v1": {
      "type": "object",
      "required": ["phase_id", "commit_sha", "branch", "files_changed"],
      "properties": {
        "phase_id": {"type": "string"},
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{7,40}$"
        },
        "branch": {"type": "string"},
        "files_changed": {
          "type": "array",
          "items": {"type": "string"}
        },
        "tests_added": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.review.report.v1": {
      "type": "object",
      "required": ["phase_id", "verdict", "findings"],
      "properties": {
        "phase_id": {"type": "string"},
        "verdict": {
          "type": "string",
          "enum": ["approve", "request_changes", "escalate"]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["severity", "summary"],
            "properties": {
              "severity": {
                "type": "string",
                "enum": ["info", "minor", "major", "critical"]
              },
              "summary": {"type": "string"},
              "file": {"type": "string"},
              "line": {"type": "integer"}
            }
          }
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.review.revision.v1": {
      "type": "object",
      "required": ["phase_id", "revisions_file_path", "required_changes"],
      "properties": {
        "phase_id": {"type": "string"},
        "revisions_file_path": {"type": "string"},
        "required_changes": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.phase.complete.v1": {
      "type": "object",
      "required": ["phase_id", "deliverables_status"],
      "properties": {
        "phase_id": {"type": "string"},
        "metrics_snapshot": {
          "type": "object",
          "properties": {
            "tokens_in": {"type": "integer"},
            "tokens_out": {"type": "integer"},
            "cost_usd": {"type": "number"},
            "duration_seconds": {"type": "integer"}
          }
        },
        "deliverables_status": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["artifact", "status"],
            "properties": {
              "artifact": {"type": "string"},
              "status": {
                "type": "string",
                "enum": ["delivered", "partial", "missing"]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.gate.updated.v1": {
      "type": "object",
      "required": ["gate_id", "status", "hard_thresholds_met"],
      "properties": {
        "gate_id": {"type": "string"},
        "status": {
          "type": "string",
          "enum": ["pending", "in_review", "passed", "failed"]
        },
        "hard_thresholds_met": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "tech.oriion.adr.draft.v1": {
      "type": "object",
      "required": ["adr_id", "title"],
      "properties": {
        "adr_id": {
          "type": "string",
          "pattern": "^ADR-[0-9]{3,4}$"
        },
        "title": {"type": "string"},
        "supersedes": {
          "type": "array",
          "items": {"type": "string"}
        },
        "informs": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.design.mock.v1": {
      "type": "object",
      "required": ["phase_id", "ui_spec_ref", "mock_assets"],
      "properties": {
        "phase_id": {"type": "string"},
        "ui_spec_ref": {
          "type": "string",
          "description": "Pointer to ui-spec in phase-spec.md or external file."
        },
        "mock_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "kind"],
            "properties": {
              "path": {"type": "string"},
              "kind": {
                "type": "string",
                "enum": ["screen", "component", "flow"]
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.evaluator.verdict.v1": {
      "type": "object",
      "required": ["prompt_id", "golden_pass_rate", "adversarial_pass_rate", "verdict"],
      "properties": {
        "prompt_id": {"type": "string"},
        "golden_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "adversarial_pass_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verdict": {
          "type": "string",
          "enum": ["approve", "request_changes", "reject"]
        }
      },
      "additionalProperties": false
    },
    "tech.oriion.security.critical.v1": {
      "type": "object",
      "required": ["cve_id", "cvss", "affected_files", "escalation_required"],
      "properties": {
        "cve_id": {"type": "string"},
        "cvss": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "affected_files": {
          "type": "array",
          "items": {"type": "string"}
        },
        "escalation_required": {"const": true}
      },
      "additionalProperties": false
    },
    "tech.oriion.acceptance.failed.v1": {
      "type": "object",
      "description": "Verifier outbound when phase acceptance criteria fail.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.acceptance.failed.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "failed_criteria_ids", "evidence_url"],
          "properties": {
            "phase_id": {"type": "string"},
            "failed_criteria_ids": {
              "type": "array",
              "items": {"type": "string"}
            },
            "evidence_url": {"type": "string", "format": "uri-reference"}
          }
        }
      }
    },
    "tech.oriion.adr.indexed.v1": {
      "type": "object",
      "description": "Memory-curator outbound when new ADR added to adr-patterns namespace.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.adr.indexed.v1"},
        "data": {
          "type": "object",
          "required": ["adr_id", "version", "indexed_at"],
          "properties": {
            "adr_id": {"type": "string", "pattern": "^ADR-[0-9]{3,4}$"},
            "version": {"type": "string"},
            "indexed_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "tech.oriion.adr.merged.v1": {
      "type": "object",
      "description": "Architect outbound to memory-curator when ADR PR merged.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.adr.merged.v1"},
        "data": {
          "type": "object",
          "required": ["adr_id", "merge_sha", "merged_at"],
          "properties": {
            "adr_id": {"type": "string", "pattern": "^ADR-[0-9]{3,4}$"},
            "merge_sha": {"type": "string", "pattern": "^[0-9a-f]{7,40}$"},
            "merged_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "tech.oriion.agent.stagnated.v1": {
      "type": "object",
      "description": "Auto-emitted at stagnation kill-switch (per cost-budget.yaml 30-min rule).",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.agent.stagnated.v1"},
        "data": {
          "type": "object",
          "required": ["role", "task_id", "last_activity_at", "killed_at"],
          "properties": {
            "role": {"type": "string"},
            "task_id": {"type": "string"},
            "last_activity_at": {"type": "string", "format": "date-time"},
            "killed_at": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "tech.oriion.arbitration.decision.v1": {
      "type": "object",
      "description": "Architect outbound resolving reviewer conflict.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.arbitration.decision.v1"},
        "data": {
          "type": "object",
          "required": ["arbitration_id", "conflicting_reviewers", "resolution", "rationale"],
          "properties": {
            "arbitration_id": {"type": "string"},
            "conflicting_reviewers": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 2
            },
            "resolution": {"type": "string"},
            "rationale": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.archive.rotated.v1": {
      "type": "object",
      "description": "Memory-curator outbound when phase archive rotated.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.archive.rotated.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "archived_path", "kept_artifacts"],
          "properties": {
            "phase_id": {"type": "string"},
            "archived_path": {"type": "string"},
            "kept_artifacts": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "tech.oriion.audit.findings.v1": {
      "type": "object",
      "description": "Architect outbound from cross-phase invariant audit.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.audit.findings.v1"},
        "data": {
          "type": "object",
          "required": ["audit_id", "findings_count", "severity_breakdown"],
          "properties": {
            "audit_id": {"type": "string"},
            "findings_count": {"type": "integer", "minimum": 0},
            "severity_breakdown": {
              "type": "object",
              "properties": {
                "info": {"type": "integer", "minimum": 0},
                "minor": {"type": "integer", "minimum": 0},
                "major": {"type": "integer", "minimum": 0},
                "critical": {"type": "integer", "minimum": 0}
              }
            }
          }
        }
      }
    },
    "tech.oriion.audit.report.v1": {
      "type": "object",
      "description": "Architect outbound full audit report.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.audit.report.v1"},
        "data": {
          "type": "object",
          "required": ["audit_id", "report_url", "recommendations"],
          "properties": {
            "audit_id": {"type": "string"},
            "report_url": {"type": "string", "format": "uri-reference"},
            "recommendations": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "tech.oriion.conflict.escalation.v1": {
      "type": "object",
      "description": "Reviewer outbound when conflict needs architect arbitration.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.conflict.escalation.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "conflicting_reviewers", "conflict_summary"],
          "properties": {
            "phase_id": {"type": "string"},
            "conflicting_reviewers": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 2
            },
            "conflict_summary": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.design.inventory_patch.v1": {
      "type": "object",
      "description": "Designer outbound when new-component-needed flagged.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.design.inventory_patch.v1"},
        "data": {
          "type": "object",
          "required": ["component_name", "justification", "mock_url"],
          "properties": {
            "component_name": {"type": "string"},
            "justification": {"type": "string"},
            "mock_url": {"type": "string", "format": "uri-reference"}
          }
        }
      }
    },
    "tech.oriion.design.ready.v1": {
      "type": "object",
      "description": "Designer outbound to frontend-implementer when mock approved.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.design.ready.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "mock_url", "ui_spec_ref"],
          "properties": {
            "phase_id": {"type": "string"},
            "mock_url": {"type": "string", "format": "uri-reference"},
            "ui_spec_ref": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.gate.metrics_ready.v1": {
      "type": "object",
      "description": "Memory-curator outbound when 80% gate-frontmatter auto-filled.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.gate.metrics_ready.v1"},
        "data": {
          "type": "object",
          "required": ["gate_id", "fields_filled", "awaiting_founder"],
          "properties": {
            "gate_id": {"type": "string"},
            "fields_filled": {
              "type": "array",
              "items": {"type": "string"}
            },
            "awaiting_founder": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "tech.oriion.gate.ready_for_narrative.v1": {
      "type": "object",
      "description": "Memory-curator outbound prompting founder for narrative sections.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.gate.ready_for_narrative.v1"},
        "data": {
          "type": "object",
          "required": ["gate_id", "prompt_template_url"],
          "properties": {
            "gate_id": {"type": "string"},
            "prompt_template_url": {"type": "string", "format": "uri-reference"}
          }
        }
      }
    },
    "tech.oriion.gate.refresh.v1": {
      "type": "object",
      "description": "Memory-curator outbound when gate metrics need re-snapshot.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.gate.refresh.v1"},
        "data": {
          "type": "object",
          "required": ["gate_id", "trigger_reason"],
          "properties": {
            "gate_id": {"type": "string"},
            "trigger_reason": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.grill.decision.v1": {
      "type": "object",
      "description": "Founder outbound to architect when grill-session locks decision.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.grill.decision.v1"},
        "data": {
          "type": "object",
          "required": ["session_id", "decisions_count", "transcript_url"],
          "properties": {
            "session_id": {"type": "string"},
            "decisions_count": {"type": "integer", "minimum": 1},
            "transcript_url": {"type": "string", "format": "uri-reference"}
          }
        }
      }
    },
    "tech.oriion.handoff.error.v1": {
      "type": "object",
      "description": "Any role outbound when malformed event received.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.handoff.error.v1"},
        "data": {
          "type": "object",
          "required": ["event_id", "error_code", "original_source"],
          "properties": {
            "event_id": {"type": "string"},
            "error_code": {"type": "string"},
            "original_source": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.iam.login.v1": {
      "type": "object",
      "description": "IAM context emission (cross-domain example for validation).",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.iam.login.v1"},
        "data": {
          "type": "object",
          "required": ["user_id", "session_id", "login_method"],
          "properties": {
            "user_id": {"type": "string"},
            "session_id": {"type": "string"},
            "login_method": {
              "type": "string",
              "enum": ["password", "oauth", "sso", "magic_link"]
            }
          }
        }
      }
    },
    "tech.oriion.memory.deprecate.v1": {
      "type": "object",
      "description": "Memory-curator outbound when memory entries marked deprecated.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.memory.deprecate.v1"},
        "data": {
          "type": "object",
          "required": ["namespace", "keys", "deprecate_reason"],
          "properties": {
            "namespace": {"type": "string"},
            "keys": {
              "type": "array",
              "items": {"type": "string"}
            },
            "deprecate_reason": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.namespace.audit.v1": {
      "type": "object",
      "description": "Memory-curator outbound after AgentDB namespace integrity check.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.namespace.audit.v1"},
        "data": {
          "type": "object",
          "required": ["namespace", "entries_total", "orphans", "mtime"],
          "properties": {
            "namespace": {"type": "string"},
            "entries_total": {"type": "integer", "minimum": 0},
            "orphans": {"type": "integer", "minimum": 0},
            "mtime": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    "tech.oriion.phase.spec.v1": {
      "type": "object",
      "description": "Founder/architect outbound delivering phase-spec to planner.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.phase.spec.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "spec_url", "dependencies"],
          "properties": {
            "phase_id": {"type": "string"},
            "spec_url": {"type": "string", "format": "uri-reference"},
            "dependencies": {
              "type": "array",
              "items": {"type": "string"}
            }
          }
        }
      }
    },
    "tech.oriion.phase.stuck.v1": {
      "type": "object",
      "description": "Verifier/planner outbound when phase blocked.",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
        "specversion": {"const": "1.0"},
        "type": {"const": "tech.oriion.phase.stuck.v1"},
        "data": {
          "type": "object",
          "required": ["phase_id", "blocker_type", "escalation_target"],
          "properties": {
            "phase_id": {"type": "string"},
            "blocker_type": {
              "type": "string",
              "enum": ["missing_dependency", "unclear_spec", "external_failure", "conflicting_review", "cost_cap_breach", "other"]
            },
            "escalation_target": {"type": "string"}
          }
        }
      }
    },
    "tech.oriion.plan.ui_phase.v1": {
      "type": "object",
      "description": "Planner outbound to designer (UI-phase distinct from generic plan.task).",
      "required": ["specversion", "id", "source", "type", "data"],
      "properties": {
