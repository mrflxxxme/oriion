# TEAMLY_RU — environment variables example
#
# Copy to .env (gitignored) для local dev. Не коммитить .env с реальными значениями.
# TBD_* literals replace перед staging/prod per .planning/PLACEHOLDERS.md.
#
# Phase 00.1 — все dev defaults работают out-of-the-box после `make dev-bootstrap`.

# ─────────────────────────────────────────────────────────────
# Dev-local (works out of the box с docker-compose.dev.yml)
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://oriion:oriion-dev@localhost:5432/oriion_dev
REDIS_URL=redis://localhost:6379/0
# SSE publisher backend (AC-W1-1). 'inprocess' for single-worker local dev;
# 'redis' (Redis Streams) for the out-of-process Dramatiq worker + gunicorn -w>1
# so /stream sees worker-produced events. docker/staging set this to 'redis' on
# BOTH the backend and worker services.
SSE_BACKEND=inprocess

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=oriion
MINIO_SECRET_KEY=oriion-dev-s3
MINIO_BUCKET=oriion-dev

BACKEND_PORT=8000
FRONTEND_PORT=5173

# ─────────────────────────────────────────────────────────────
# Runtime mode (Phase 00.2+)
# ─────────────────────────────────────────────────────────────
APP_ENV=dev

# ─────────────────────────────────────────────────────────────
# JWT auth (Phase 00.2)
# Min 32 chars. Только для dev — never reuse в staging/prod.
# Generate prod secret via: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotation: introduce JWT_SECRET_ACCESS_V2 alongside V1 for 7-day grace period (Wave 1+).
# ─────────────────────────────────────────────────────────────
JWT_SECRET_ACCESS_V1=changeme-dev-only-please-replace-in-prod-min-32-chars
JWT_ISS=oriion-iam
JWT_AUD=oriion-app
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=604800

# ─────────────────────────────────────────────────────────────
# Email verification + consent (Phase 00.2 / FZ-152 invariant 6)
# REQUIRE_EMAIL_VERIFICATION: true blocks login until verify-email; false in dev.
# CONSENT_VERSION_CURRENT: pinned at grant time; never mutated retroactively.
# ─────────────────────────────────────────────────────────────
REQUIRE_EMAIL_VERIFICATION=false
CONSENT_VERSION_CURRENT=2026-05-17

# ─────────────────────────────────────────────────────────────
# Rate-limit (Phase 00.2)
# Window = 900s (15 min); per-scope thresholds defined in rate_limit_service.
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_SECONDS=900

# ─────────────────────────────────────────────────────────────
# TBD-tokens — replace перед staging/prod
# Source-of-truth: .planning/PLACEHOLDERS.md
# ─────────────────────────────────────────────────────────────

# Yandex Cloud — provisioning Phase 00.6 (manual runbook, no Terraform)
YC_FOLDER_ID=TBD_YC_FOLDER_ID_DEV
YC_SERVICE_ACCOUNT=TBD_YC_SERVICE_ACCOUNT_DEPLOY
YC_OBJECT_STORAGE_BUCKET=TBD_YC_OBJECT_STORAGE_BUCKET

# Brand / domain — OQ-09 open
BRAND_DOMAIN=TBD_BRAND_DOMAIN

# LLM providers — BYOK режим с дня 1 (Wave 0 internal demo)
# Naming aligned с Settings field names в src/_shared/config.py (Phase 00.6
# Commit 13 hygiene fix; legacy YANDEX_GPT_* names from Phase 00.4 retired).
# YandexGPT auth is hybrid: YANDEX_API_KEY (Api-Key схема, не протухает) —
# ПРЕДПОЧТИТЕЛЬНЕЕ IAM-токена; YANDEX_IAM_TOKEN (Bearer, ~12h TTL via
# `yc iam create-token --impersonate-service-account-id <sa-id>`) — legacy/
# failover. Provider uses Api-Key when set, else Bearer. Folder id required.
DEEPSEEK_API_KEY=TBD_DEEPSEEK_API_KEY
YANDEX_API_KEY=TBD_YANDEX_API_KEY
YANDEX_IAM_TOKEN=TBD_YANDEX_IAM_TOKEN
YANDEX_CATALOG_ID=TBD_YANDEX_CATALOG_ID
GIGACHAT_AUTH_KEY=TBD_GIGACHAT_AUTH_KEY
# GigaChat TLS (AC-W1-21). *.sberbank.ru is signed by the Russian Trusted Root CA;
# httpx/certifi ignores the OS trust store, so point GIGACHAT_CA_BUNDLE at a bundle
# that includes it. The backend image installs the CA + sets this to the system
# bundle automatically; override only for a custom path. Leave VERIFY_SSL=true in
# real envs — false is a dev-only escape hatch for hosts missing the RU CA.
GIGACHAT_VERIFY_SSL=true
GIGACHAT_CA_BUNDLE=
# Per-call httpx timeout (s) for all LLM providers. Default 120 (was 30) — long
# writer gen (≥1500-word brief) exceeds 30s; aligned with AC8 cohort p95 ≤120s.
LLM_PROVIDER_TIMEOUT_SECONDS=120

# ─────────────────────────────────────────────────────────────
# BYOK + KMS (Phase 00.4 — LLM Gateway)
# Wave 0: LocalAESKMS (master key from env). Phase 00.6 swaps to Yandex KMS.
# Generate dev master key: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────
KMS_BACKEND=local
BYOK_MASTER_KEY_B64=TBD_BYOK_MASTER_KEY_B64
YANDEX_CLOUD_KMS_KEY_ID=TBD_YANDEX_CLOUD_KMS_KEY_ID

# ─────────────────────────────────────────────────────────────
# FX rate (Phase 00.4 — RU-currency billing per ADR-018 amendment)
# Wave 0: pinned env constant. Wave 1+: live CBR API feed cached 1h.
# ─────────────────────────────────────────────────────────────
FX_RATE_USD_TO_RUB=100.0

# ─────────────────────────────────────────────────────────────
# MCP built-in tools (Phase 00.4 — web_search + read_url)
# WEB_SEARCH_MOCK_MODE=true returns canned results without real API keys.
# ─────────────────────────────────────────────────────────────
WEB_SEARCH_MOCK_MODE=true
BRAVE_SEARCH_API_KEY=TBD_BRAVE_SEARCH_API_KEY
YANDEX_SEARCH_API_KEY=TBD_YANDEX_SEARCH_API_KEY

# Observability — Phase 00.6 deliverable
SENTRY_DSN=TBD_SENTRY_DSN
# Prometheus /metrics port for the Dramatiq dispatch worker (AC-W1-13). Under
# async dispatch the orchestration runs in the worker, so its llm_*/task_*
# metrics are exposed here (scraped by the `oriion-worker` Prometheus job),
# separate from the web tier's backend:8000/metrics. 0 disables the exporter.
WORKER_METRICS_PORT=9191

# Git host — OQ-11 closed, identifier'ы зависят от регистрации
GITHUB_ORG=TBD_GITHUB_ORG
GITHUB_REPO=TBD_GITHUB_REPO
