# infra/staging-minimal.env.example — template for the VPS minimal pilot.
# ─────────────────────────────────────────────────────────────────────────────
# On the VPS:  cp infra/staging-minimal.env.example infra/vps-minimal.env
# then fill EVERY <…> below. infra/vps-minimal.env is gitignored — NEVER commit it.
#
# Two consumers, one file:
#   * docker compose --env-file infra/vps-minimal.env …   (host interpolation of ${VAR})
#   * env_file: vps-minimal.env in the compose             (injected into backend/worker)
#
# Generate the three secrets locally (they must NOT be dev defaults or the
# APP_ENV=staging boot guard fails):
#   BYOK_MASTER_KEY_B64   ->  openssl rand -base64 32
#   JWT_SECRET_ACCESS_V1  ->  openssl rand -hex 32
#   PG_PASSWORD           ->  openssl rand -hex 16
#   MINIO_ROOT_PASSWORD   ->  openssl rand -hex 16

# ── Images (GHCR after the build-images-ghcr workflow runs) ──────────────────
YC_CR_REGISTRY=ghcr.io/<your-github-owner>
IMAGE_TAG=latest

# ── Inline datastore credentials (host-interpolated into the compose) ────────
PG_PASSWORD=<openssl rand -hex 16>
MINIO_ROOT_USER=oriion
MINIO_ROOT_PASSWORD=<openssl rand -hex 16>

# ── App secrets (injected into backend + worker containers) ──────────────────
# 32+ chars, NOT the dev default:
JWT_SECRET_ACCESS_V1=<openssl rand -hex 32>
# base64 of 32 random bytes (LocalAESKMS master key — encrypts BYOK keys + TOTP secrets):
BYOK_MASTER_KEY_B64=<openssl rand -base64 32>
KMS_BACKEND=local
# Leave Lockbox OFF for the minimal box (plain env). Do NOT set LOCKBOX_SECRET_ID.

# ── SMTP (real verification e-mail — Phase 01.8-mail) ────────────────────────
# Free path: a personal Yandex account app-password (id.yandex.ru → Passwords for apps → Mail).
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USER=<you>@yandex.ru
SMTP_PASSWORD=<yandex-app-password>
SMTP_FROM=<you>@yandex.ru
EMAIL_VERIFY_URL_BASE=https://staging.<your-domain>/verify-email

# ── LLM / search keys (copy from the funded backend/.env) ────────────────────
DEEPSEEK_API_KEY=<funded>
GIGACHAT_AUTH_KEY=<funded>
YANDEX_API_KEY=<funded>
YANDEX_IAM_TOKEN=<funded>
YANDEX_CATALOG_ID=<funded>
YANDEX_SEARCH_API_KEY=<funded>
BRAVE_SEARCH_API_KEY=<funded>

# ── Caddy / TLS (host-interpolated) ──────────────────────────────────────────
# Real domain + auto Let's Encrypt: set the FQDN and leave CADDY_GLOBAL_OPTS empty.
CADDY_SITE_ADDR=staging.<your-domain>
CADDY_GLOBAL_OPTS=
CADDY_ACME_EMAIL=<you>@<your-domain>
# IP-only test WITHOUT a domain instead: CADDY_SITE_ADDR=:80 and CADDY_GLOBAL_OPTS=auto_https off

# ── Non-secret config ────────────────────────────────────────────────────────
FX_RATE_USD_TO_RUB=100.0
